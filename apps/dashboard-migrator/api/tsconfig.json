{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "lib": ["esnext", "es2021.intl"],
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@dynatrace/js-runtime/types", "../node_modules/@types"],
    "types": ["node", "runtime"]
  },
  "include": ["**/*.ts"]
}
