{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm install --legacy-peer-deps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ],
    "deny": [
      "Bash(npx dt-app deploy:*)",
      "Bash(npm run deploy:*)",
      "Read(**/.dt-app/.tokens.json)"
    ]
  }
}
