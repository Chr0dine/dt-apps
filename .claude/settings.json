{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm install --legacy-peer-deps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(dtctl doctor:*)",
      "Bash(dtctl query:*)",
      "Bash(npx dt-app dev:*)"
    ],
    "ask": [
      "Bash(npx dt-app deploy:*)",
      "Bash(npm run deploy:*)"
    ],
    "deny": [
      "Read(**/.dt-app/.tokens.json)"
    ]
  }
}
